            "emotion": "speaking",
            "showPortrait": true,
            "portrait": ""
          },
          {
            "speaker": "speaker-1789852672609",
            "text": "Оба предмета. Я помню.",
            "textUk": "Обидва предмети. Я пам’ятаю.",
