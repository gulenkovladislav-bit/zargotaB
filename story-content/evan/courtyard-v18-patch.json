                  "textUk": "Ці залишу при собі."
                },
                {
                  "text": "Сошлось.",
                  "textUk": "Зійшлося."
                }
              ],
              "loss": [
                {
                  "text": "Поторопился.",
                  "textUk": "Поквапився."
                },
                {
                  "text": "Ладно. Теперь понятнее.",
                  "textUk": "Гаразд. Тепер зрозуміліше."
                },
                {
                  "text": "В следующий раз проверю дважды.",
                  "textUk": "Наступного разу перевірю двічі."
                }
              ]
            }
          }
        }
      }
    }
  ]
}
